# Copie este arquivo para .env e preencha apenas a chave.
# Nunca envie sua chave real para o GitHub.

OPENROUTER_API_KEY=cole_sua_chave_aqui

# Hipótese de protótipo: roteador gratuito do OpenRouter.
# Pode ser trocado sem alterar o código.
AI_MODEL=openrouter/free
AI_API_URL=https://openrouter.ai/api/v1/chat/completions

# Durante o MVP 2, apenas comentários iniciados por este gatilho chamam a IA.
AI_TRIGGER=!ia

# Opcional: substitui a persona provisória definida no código.
# PERSONA_PROMPT=...
