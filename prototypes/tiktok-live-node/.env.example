# Copie este arquivo para .env e preencha apenas a chave.
# Nunca envie sua chave real para o GitHub.

OPENROUTER_API_KEY=cole_sua_chave_aqui

# Modelo principal atual do protótipo.
# A disponibilidade de modelos gratuitos pode mudar sem aviso.
AI_MODEL=nvidia/nemotron-3.5-lightning:free

# Fallbacks tentados automaticamente se o modelo principal estiver indisponível,
# responder sem texto útil ou retornar apenas classificação de segurança.
AI_FALLBACK_MODELS=minimax/minimax-m3:free,liquid/lfm-2.5-2.6b:free

AI_API_URL=https://openrouter.ai/api/v1/chat/completions

# Durante o MVP 2, comentários iniciados por !ia ou ia chamam a IA.
AI_TRIGGER=!ia

# EXPERIMENTAL: quando true, o personagem responde a TODOS os comentários,
# ignorando o gatilho acima (só pula comentários vazios ou só de emoji/pontuação).
# Atenção: a fala é serial (uma voz por vez, ~8-12 s por resposta). Em chat movimentado
# a fila acumula atraso e passa a responder comentários antigos. Mantenha false até
# validar o ritmo em LIVE real.
AI_RESPOND_ALL=false

# Opcional: substitui a persona provisória. O comando live:bob já fornece uma
# persona curta do Bob quando esta variável não estiver preenchida.
# PERSONA_PROMPT=...

# MVP 3 — TTS local no Windows.
# Ative para converter cada resposta da IA em áudio no computador.
TTS_ENABLED=true

# Fallback local: voz nativa instalada no Windows, sem nova chave.
TTS_PROVIDER=windows-sapi

# Opcional: nome exato de uma voz instalada. Vazio prefere automaticamente uma voz pt-BR.
TTS_VOICE=

# Velocidade do Windows SpeechSynthesizer: inteiro entre -10 e 10; 0 é o padrão.
TTS_RATE=0

# Voz neural Fish Audio. Para ativar, troque TTS_PROVIDER para fish-audio,
# crie uma chave no painel Fish Audio e informe uma referência cujo uso esteja autorizado.
# Nunca envie a chave real para o GitHub.
FISH_AUDIO_API_KEY=cole_sua_chave_aqui
FISH_AUDIO_REFERENCE_ID=
FISH_AUDIO_MODEL=s2.1-pro-free
FISH_AUDIO_API_URL=https://api.fish.audio/v1/tts
FISH_AUDIO_LATENCY=balanced

# MVP 6/7 — Sincronização labial dinâmica (lip sync) do Bob Esponja nas falas do TTS.
# Padrão: false (preserva o vídeo estático spongebob-speaking-v1.mp4).
# Quando true, decompõe a fala em visemas PT-BR e anima a boca dinamicamente na prévia.
LIP_SYNC_ENABLED=false
LIP_SYNC_ASSETS_DIRECTORY=assets/mvp7/lipsync
LIP_SYNC_MIN_HOLD_MS=65

# Orquestração da conversa do Bob. O comando live:bob ativa o motor automaticamente.
INTERACTION_ENABLED=false

# Arquivo editável com as falas de abertura e de ambiente.
INTERACTION_LINES_FILE=config/live-lines.json

# Fala inicial ocorre somente depois que o PowerShell mostrar "Conectado".
INTERACTION_OPENING_ENABLED=true
INTERACTION_OPENING_DELAY_MS=3000

INTERACTION_WELCOME_ENABLED=true
INTERACTION_WELCOME_BATCH_MS=10000
INTERACTION_WELCOME_COOLDOWN_MS=15000
INTERACTION_WELCOME_MAX_NAMES=3
INTERACTION_AMBIENT_ENABLED=true
INTERACTION_AMBIENT_MIN_SILENCE_MS=30000
INTERACTION_AMBIENT_MAX_SILENCE_MS=45000
INTERACTION_MAX_PENDING=12

# Anti-inanicao: um item que esperou mais que isso passa na frente, mesmo com
# prioridade menor. Evita que a saudacao de entrada (60) nunca fale num chat
# cheio de perguntas (80), principalmente com AI_RESPOND_ALL=true.
INTERACTION_STARVATION_MS=20000

# Quantos itens do MESMO tipo podem ficar pendentes. Reserva lugar na fila
# para entradas, presentes e videos quando as perguntas chegam em rajada.
INTERACTION_MAX_PENDING_PER_KIND=4

# Cena visual integrada. O comando npm run live:bob ativa automaticamente a cena,
# seleciona Bob Esponja e aguarda a conta entrar ao vivo.
SCENE_ENABLED=false
SCENE_VARIANT=spongebob
SCENE_ASSETS_DIRECTORY=assets/mvp4
SCENE_THINKING_MS=3000
SCENE_PREVIEW_PORT=3333
SCENE_PREVIEW_OPEN_BROWSER=true
SCENE_PREVIEW_SHOW_BADGE=false

# MVP 6 — cinco vídeos pré-gravados acionados por palavra no comentário.
# O comando npm run live:bob ativa automaticamente. Os MP4s ficam fora do Git:
# copie-os do Google Drive para a pasta abaixo.
VIDEO_TRIGGERS_ENABLED=false
VIDEO_TRIGGERS_FILE=config/video-triggers.json
VIDEO_ASSETS_DIRECTORY=assets/mvp6

# Tempo mínimo, em segundos, antes do MESMO vídeo poder tocar de novo.
VIDEO_TRIGGER_COOLDOWN_SECONDS=60

# Opcional: usar o vídeo de convite como fala de ambiente no silêncio.
VIDEO_AMBIENT_ENABLED=false

# Rede de segurança: se o player não avisar o fim, volta ao idle depois disso.
# O contrato normal é o evento real de término do vídeo, não este tempo.
VIDEO_PLAYBACK_TIMEOUT_MS=60000

# Reconexão usada pelo comando live:bob enquanto a LIVE ainda não começou.
TIKTOK_CONNECT_RETRY_MS=5000

# MVP 6 — Rotação de vídeos de ambiente (apresentação contínua).
# Ative e edite config/ambient-rotation.json com os clipes desejados.
# O sistema reveza entre os clipes disponíveis, respeitando o cooldown.
# Com 0 clipes configurados (ou arquivo ausente), cai para TTS de ambiente.
AMBIENT_ROTATION_ENABLED=false
AMBIENT_ROTATION_FILE=config/ambient-rotation.json
AMBIENT_ROTATION_COOLDOWN_SECONDS=5
# Embaralha a ordem dos clipes a cada rodada em vez de ordem sequencial.
AMBIENT_ROTATION_SHUFFLED=false

# MVP 6 — Vídeos de agradecimento por presente específico.
# Edite config/gift-videos.json para mapear nomes/IDs de presente a arquivos MP4.
# Quando o presente não tiver vídeo mapeado, usa o agradecimento dinâmico por TTS.
GIFT_VIDEOS_ENABLED=true
GIFT_VIDEOS_FILE=config/gift-videos.json
